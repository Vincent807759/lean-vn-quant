# ==============================================================================
# LEAN VN-QUANT & WORLDQUANT BRAIN BRIDGE CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your local root directory:
#    cp .env.example .env
# 2. Fill in your actual credentials below.
# 3. DO NOT COMMIT '.env' TO GITHUB OR ANY VERSION CONTROL!
# ==============================================================================

# WorldQuant BRAIN Platform Credentials (Optional for local simulator)
BRAIN_EMAIL="your_email@example.com"
BRAIN_PASSWORD="your_brain_password"

# Telegram Bot Notification & Interactive Control (Optional)
# - Create your bot via @BotFather on Telegram to get TELEGRAM_BOT_TOKEN
# - Get your chat ID via @userinfobot to get TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
